<Window x:Class="GhostWidget.CaptureGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GhostWidget"
        Width="420" Height="520" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Height" Value="52"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#F33B3B"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CaptureRoot" Background="#FFFDFC" CornerRadius="25" BorderBrush="#1A000000" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.32"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#17131C" CornerRadius="24,24,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0,18,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="안개 숲 포획" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="WildInfoText" Foreground="#AFA9B5" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Click="Close_Click"
                            FontSize="22" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,17,20,20">
                <Grid.RowDefinitions><RowDefinition Height="302"/><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#09080B" CornerRadius="19" ClipToBounds="True">
                    <Grid>
                        <Canvas Opacity="0.55">
                            <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="35" Canvas.Top="42"/>
                            <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="310" Canvas.Top="58"/>
                            <Ellipse Width="3" Height="3" Fill="#9F91FF" Canvas.Left="340" Canvas.Top="210"/>
                            <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="72" Canvas.Top="236"/>
                            <Ellipse Width="4" Height="4" Fill="#F3D77D" Canvas.Left="188" Canvas.Top="28"/>
                        </Canvas>
                        <Border Width="270" Height="44" CornerRadius="14" Background="#CC211D28" VerticalAlignment="Top" Margin="0,15,0,0">
                            <TextBlock x:Name="GuideText" Text="빠른 에임이 유령 몸통에 들어올 때 사격하세요" Foreground="#E8E3EB" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Grid x:Name="EncounterGroup" Width="180" Height="200" VerticalAlignment="Center" Margin="0,43,0,0">
                            <Grid.RenderTransform><TranslateTransform x:Name="EncounterMove"/></Grid.RenderTransform>
                            <local:GhostArtwork x:Name="WildGhostArtwork" Width="100" Height="124" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="GradeBadge" Background="#FFF2A8" CornerRadius="13" Height="28" Padding="12,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0">
                                <TextBlock x:Name="GradeText" Text="PERFECT" Foreground="#17131C" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid x:Name="AimGroup" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><TranslateTransform x:Name="AimMove"/></Grid.RenderTransform>
                            <Ellipse x:Name="AimRing" Width="38" Height="38" Stroke="#F33B3B" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect><DropShadowEffect Color="#FF3B3B" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/></Ellipse.Effect>
                            </Ellipse>
                            <Line X1="4" Y1="21" X2="38" Y2="21" Stroke="#F33B3B" StrokeThickness="2"/>
                            <Line X1="21" Y1="4" X2="21" Y2="38" Stroke="#F33B3B" StrokeThickness="2"/>
                            <Ellipse Width="5" Height="5" Fill="#F33B3B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,18,0" Background="#D8110E15" CornerRadius="12" Padding="10,6">
                            <TextBlock x:Name="WildHpText" Foreground="#FFF0F0" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,66,0,0" Background="#D8110E15" CornerRadius="12" Padding="10,6">
                            <TextBlock x:Name="PlayerHpText" Foreground="#D5CBFF" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="4,7,4,0">
                    <TextBlock x:Name="ResultText" Text="빠르게 움직이는 에임을 유령 몸통에 맞추세요." Foreground="#5D5661" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="275" HorizontalAlignment="Left"/>
                    <Border HorizontalAlignment="Right" Background="#F1EEF3" CornerRadius="11" Padding="10,6">
                        <TextBlock x:Name="OrbText" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </Grid>

                <Button x:Name="ThrowButton" Grid.Row="2" Style="{StaticResource RoundButton}" Content="⊕  조준 사격" Click="Throw_Click" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Border>
</Window>
