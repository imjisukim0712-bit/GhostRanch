<Window x:Class="GhostWidget.FarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GhostWidget"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="420" Height="700" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="box" Background="{TemplateBinding Background}" CornerRadius="16" Padding="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostChoice" TargetType="Button">
            <Setter Property="Width" Value="64"/><Setter Property="Height" Value="78"/><Setter Property="Margin" Value="0,0,1,4"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="13"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/><Setter Property="Background" Value="#E7E5E9"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border Background="{TemplateBinding Background}" CornerRadius="4"/><Border x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/></Border></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PanelRoot" CornerRadius="25" Background="#FFFDFC" BorderBrush="#17000000" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.3"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#17131C" CornerRadius="24,24,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0,18,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="유령 농장" Foreground="White" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="포획하고, 키우고, 결투하세요" Foreground="#AFA9B5" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34"
                            FontSize="22" Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,17,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/><RowDefinition Height="142"/><RowDefinition Height="78"/>
                    <RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#F2EFF4" CornerRadius="12" Padding="10,6" Margin="3"><TextBlock x:Name="LunaText" FontWeight="Bold" FontSize="11"/></Border>
                    <Border Background="#F2EFF4" CornerRadius="12" Padding="10,6" Margin="3"><TextBlock x:Name="OrbText" FontWeight="Bold" FontSize="11"/></Border>
                    <Border Background="#F2EFF4" CornerRadius="12" Padding="10,6" Margin="3"><TextBlock x:Name="WinText" FontWeight="Bold" FontSize="11"/></Border>
                </StackPanel>

                <Border Grid.Row="1" Background="#09080B" CornerRadius="18" Padding="16" Margin="0,8,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <local:GhostArtwork x:Name="PanelGhostArtwork" Width="92" Height="104" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="GhostNameText" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="LevelText" Foreground="#A8A2AD" FontSize="11" Margin="0,2,0,2"/>
                            <TextBlock x:Name="PersonalityText" Foreground="#DCC7FF" FontSize="10" Margin="0,0,0,7"/>
                            <TextBlock Text="친밀도" Foreground="#B8B2BE" FontSize="10"/>
                            <ProgressBar x:Name="AffectionBar" Maximum="100" Foreground="#F33B3B" Margin="0,4,0,7"/>
                            <TextBlock Text="기력" Foreground="#B8B2BE" FontSize="10"/>
                            <ProgressBar x:Name="EnergyBar" Maximum="100" Foreground="#4356E0" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="CaptureButton" Grid.Column="0" Style="{StaticResource ActionButton}" Background="#74717A" Click="Capture_Click"/>
                    <Button x:Name="RaiseButton" Grid.Column="1" Style="{StaticResource ActionButton}" Background="#74717A" Click="Raise_Click"/>
                    <Button x:Name="BattleButton" Grid.Column="2" Style="{StaticResource ActionButton}" Background="#74717A" Click="Battle_Click"/>
                </Grid>

                <Border Grid.Row="3" Background="#F4F1F5" CornerRadius="14" Padding="14,9" Margin="4,5">
                    <TextBlock x:Name="ResultText" Text="오늘은 어떤 일을 해볼까요?" TextWrapping="Wrap" Foreground="#4B4550" FontSize="11" LineHeight="16" VerticalAlignment="Center"/>
                </Border>

                <Grid Grid.Row="4" Margin="4,7,4,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                            <TextBlock x:Name="RosterCountText" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="상점" Height="28" Padding="11,0" Margin="0,0,5,0"
                                        Background="#6557DB" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="Shop_Click"/>
                                <Button Content="뽑기 100" Height="28" Padding="11,0" Margin="0,0,5,0"
                                        Background="#F0A51D" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="Gacha_Click"/>
                                <Button Content="휴식 +30" Height="28" Padding="11,0"
                                        Background="#17131C" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="Rest_Click"/>
                            </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="-3,7,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RosterItems">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostChoice}" Tag="{Binding Index}" IsEnabled="{Binding Unlocked}"
                                            Background="Transparent" Click="GhostChoice_Click">
                                        <StackPanel>
                                            <Border Width="52" Height="54" CornerRadius="12" BorderThickness="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1EEF3"/>
                                                        <Setter Property="BorderBrush" Value="{Binding BorderColor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                                <Setter Property="Background" Value="#E9E5EB"/>
                                                                <Setter Property="BorderBrush" Value="#D1CAD6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <local:GhostArtwork ColorCode="{Binding Color}" Form="{Binding Form}" Width="47" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <local:GhostArtwork.Style>
                                                        <Style TargetType="local:GhostArtwork">
                                                            <Setter Property="Opacity" Value="0.26"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Unlocked}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </local:GhostArtwork.Style>
                                                </local:GhostArtwork>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Width="60" Foreground="#5A5460"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <TextBlock Grid.Row="5" Text="TIP  ·  결투 2승마다 봉인구를 하나 얻어요." Foreground="#96909A" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
