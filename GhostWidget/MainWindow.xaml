<Window x:Class="GhostWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GhostWidget"
        Title="유령 농장"
        Width="250" Height="278"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded" Closed="Window_Closed"
        MouseMove="Window_MouseMove" MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F8F7FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Storyboard x:Key="FloatStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="FloatTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-9" Duration="0:0:1.45">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SwayTransform"
                             Storyboard.TargetProperty="Angle"
                             From="-1.4" To="1.4" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Canvas x:Name="Root" Width="250" Height="278">
        <!-- The bubble grows for long dialogue and wraps before it can run off the widget. -->
        <Grid x:Name="Speech" Canvas.Left="8" Canvas.Top="4" MinWidth="82" MaxWidth="234"
              Opacity="0" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="11"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MinHeight="42" Padding="13,7,13,7" CornerRadius="18"
                    Background="#F8FFFFFF" BorderBrush="#26000000" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.22"/>
                </Border.Effect>
                <TextBlock x:Name="SpeechText" Text="Boo!" Foreground="#17131F"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" LineHeight="18"
                           MaxWidth="206" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Path Grid.Row="1" Data="M 0,0 L 12,0 L 6,10 Z" Fill="#F8FFFFFF"
                  HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Grid>

        <Grid x:Name="GhostLayer" Canvas.Left="25" Canvas.Top="53" Width="200" Height="200"
              RenderTransformOrigin="0.5,0.5"
              MouseLeftButtonDown="Ghost_MouseLeftButtonDown"
              MouseLeave="Ghost_MouseLeave">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="GrowthTransform" ScaleX="1" ScaleY="1"/>
                    <ScaleTransform x:Name="SizeTransform" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="SwayTransform" Angle="0"/>
                    <TranslateTransform x:Name="FloatTransform" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.ContextMenu>
                <ContextMenu Background="#F21A1723" BorderBrush="#33303B" BorderThickness="1"
                             HasDropShadow="True" Padding="5">
                    <MenuItem Header="▣  유령 농장 열기" Click="OpenFarm_Click"/>
                    <MenuItem Header="🏠  유령 상점 열기" Click="OpenDecorShop_Click"/>
                    <MenuItem Header="👥  잡은 유령 모두 소환" Click="SummonCaughtGhosts_Click"/>
                    <MenuItem Header="↩  소환 유령 해산" Click="DismissSummonedGhosts_Click"/>
                    <Separator Background="#35313F" Margin="8,4"/>
                    <MenuItem Header="●  달과자 먹이기 · 기력 회복" Click="Feed_Click"/>
                    <MenuItem Header="↑  유령 훈련 · 경험치" Click="Train_Click"/>
                    <MenuItem Header="⚔  결투 연습" Click="Battle_Click"/>
                    <MenuItem Header="☾  잠깐 쉬기" Click="Rest_Click"/>
                    <Separator Background="#35313F" Margin="8,4"/>
                    <MenuItem Header="◉  다른 유령 부르기" Click="ChangeGhost_Click"/>
                    <MenuItem Header="💬  말 걸기" Click="Talk_Click"/>
                    <MenuItem Header="유령 크기 · 초대형" Click="SizeHuge_Click"/>
                    <MenuItem Header="유령 크기 · 상" Click="SizeLarge_Click"/>
                    <MenuItem Header="유령 크기 · 중" Click="SizeMedium_Click"/>
                    <MenuItem Header="유령 크기 · 하" Click="SizeSmall_Click"/>
                    <MenuItem Header="상태 보기" Click="Status_Click"/>
                    <MenuItem Header="위젯 종료" Click="Exit_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- The base form preserves the supplied 64:80 silhouette; themed forms deliberately change it. -->
            <local:GhostArtwork x:Name="MainGhostArtwork" Width="200" Height="200"/>
        </Grid>

        <Canvas x:Name="ParticleLayer" IsHitTestVisible="False" Width="250" Height="278"/>
    </Canvas>
</Window>
